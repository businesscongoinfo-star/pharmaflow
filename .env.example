# ============================================================
# PHARMAFLOW — VARIABLES D'ENVIRONNEMENT
# ============================================================
# Copier ce fichier en `.env.local` et compléter les valeurs.
# Ne JAMAIS commiter `.env.local`.
# ============================================================

# ------------------------------------------------------------
# SUPABASE (obligatoire)
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé publique (nouvelle nomenclature Supabase)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Rétro-compatibilité : clé anon des anciens projets
# NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx

# Clé secrète — UNIQUEMENT côté serveur (jamais en NEXT_PUBLIC_*)
SUPABASE_SECRET_KEY=sb_secret_xxx

# Alias accepté par certains webhooks
# SUPABASE_SERVICE_ROLE_KEY=xxx

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://pharmaflow.africa
NEXT_PUBLIC_APP_URL=https://pharmaflow.africa

# ------------------------------------------------------------
# SUPPORT IA (OpenAI)
# ------------------------------------------------------------
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4.1-mini

# ------------------------------------------------------------
# CHIFFREMENT DES INTÉGRATIONS
# ------------------------------------------------------------
PHARMAFLOW_CONFIG_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ------------------------------------------------------------
# PAIEMENTS — MOKO AFRIKA
# ------------------------------------------------------------
MOKO_AFRIKA_MODE=sandbox

# ------------------------------------------------------------
# PAIEMENTS — GOFRESHPAY
# ------------------------------------------------------------
GOFRESHPAY_MODE=sandbox
GOFRESHPAY_BASE_URL=
GOFRESHPAY_MERCHANT_ID=
GOFRESHPAY_MERCHANT_SECRET=
GOFRESHPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------
# PAIEMENTS — YABETOO
# ------------------------------------------------------------
YABETOO_MODE=sandbox
YABETOO_BASE_URL=
YABETOO_SECRET_KEY=

# ------------------------------------------------------------
# PAIEMENTS — PAYPAL
# ------------------------------------------------------------
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
